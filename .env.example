# انسخ هذا الملف باسم .env ثم عدّل القيم
SECRET_KEY=غيّر-هذه-القيمة-إلى-نص-عشوائي-طويل

# إعدادات البريد (مثال: Gmail مع "كلمة مرور التطبيقات" App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# البريد الذي يستقبل إشعارات الزوار الجدد (بريدك أنت)
OWNER_EMAIL=your.email@gmail.com
SITE_URL=https://your-domain.com
